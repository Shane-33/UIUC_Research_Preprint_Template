% Brand header - formal full-color mark supplied by the author.
\newcommand{\uiucwordmark}{\includegraphics[width=2.33in]{assets/Illinois_formal_wordmark_tm_fullcolor_rgb.png}}
\newcommand{\uiucbrandrow}{%
  \noindent\begin{minipage}[c]{0.58\linewidth}\raggedright\uiucwordmark\end{minipage}%
  \hfill\begin{minipage}[c]{0.38\linewidth}\raggedleft
     {\sffamily\fontsize{8}{10}\selectfont\color{uiucmuted}\MakeUppercase{Research Preprint}\\[2pt]\paperdate\par}%
  \end{minipage}\par\vspace{10pt}%
  {\color{uiucline}\rule{\linewidth}{0.55pt}}\par}

% Main (recommended): left-aligned editorial title and abstract.
\newcommand{\uiuceditorialtitle}{%
  \uiucbrandrow
  \vspace{15pt}%
  {\raggedright\sffamily\bfseries\fontsize{20}{24}\selectfont\color{uiucink}\papertitle\par}
  \vspace{12pt}%
  {\raggedright\sffamily\fontsize{10.5}{13}\selectfont\color{uiucink}\authorline\par}%
  \vspace{5pt}%
  {\raggedright\sffamily\fontsize{8.8}{11.5}\selectfont\color{uiucmuted}\affiliationline\par}%
  \vspace{4pt}%
  {\raggedright\sffamily\fontsize{8.7}{11.2}\selectfont\color{uiucmuted}\contactline\par}%
  \vspace{13pt}%
  {\color{uiucline}\rule{\linewidth}{0.5pt}}\par\vspace{9pt}%
  \noindent\begin{minipage}{\linewidth}\small
    {\sffamily\bfseries\fontsize{9.6}{12}\selectfont\color{uiucink}Abstract}\par\vspace{3pt}
    {\fontsize{9.5}{12.5}\selectfont\paperabstract\par}%
  \end{minipage}\par
  \vspace{10pt}{\color{uiucline}\rule{\linewidth}{0.5pt}}\par\vspace{11pt}%
}

% Alternative: centered academic title, same understated branding.
\newcommand{\uiucclassictitle}{%
  \uiucbrandrow
  \vspace{14pt}%
  {\centering\sffamily\bfseries\fontsize{19.5}{23}\selectfont\color{uiucink}\papertitle\par}
  \vspace{12pt}%
  {\centering\sffamily\fontsize{10.4}{13}\selectfont\color{uiucink}\authorline\par}%
  \vspace{5pt}%
  {\centering\sffamily\fontsize{8.8}{11.5}\selectfont\color{uiucmuted}\affiliationline\par}%
  \vspace{4pt}%
  {\centering\sffamily\fontsize{8.7}{11.2}\selectfont\color{uiucmuted}\contactline\par}%
  \vspace{13pt}%
  {\color{uiucline}\rule{\linewidth}{0.5pt}}\par\vspace{8pt}%
  \noindent\begin{minipage}{\linewidth}\small
    {\centering\sffamily\bfseries\fontsize{9.6}{12}\selectfont\color{uiucink}Abstract\par}\vspace{4pt}
    {\fontsize{9.5}{12.5}\selectfont\paperabstract\par}%
  \end{minipage}\par
  \vspace{10pt}{\color{uiucline}\rule{\linewidth}{0.5pt}}\par\vspace{11pt}%
}

\newcommand{\best}[1]{\textbf{#1}}
\newcommand{\second}[1]{\underline{#1}}
\newcommand{\exampledata}{\textsf{Illustrative values}}
