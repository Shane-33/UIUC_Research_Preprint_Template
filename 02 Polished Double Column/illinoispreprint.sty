  citecolor=illinoisblue,urlcolor=illinoisblue,pdfborder={0 0 0},bookmarksnumbered=true]{hyperref}
\RequirePackage[nameinlink,capitalise,noabbrev]{cleveref}
\urlstyle{same}
\setlength{\parindent}{1em}
\setlength{\parskip}{0pt}
\setlength{\columnsep}{0.25in}
\setlength{\textfloatsep}{12pt plus 2pt minus 2pt}
\setlength{\floatsep}{9pt plus 2pt minus 2pt}
\setlist{itemsep=0.08em,topsep=0.28em,leftmargin=1.55em}
\captionsetup{font=small,labelfont=bf,labelsep=colon,skip=5pt}
\captionsetup[table]{position=top}

% Public editing fields. Leave the label empty to match the reference exactly.
\def\illinois@papertitle{Your Research Paper Title}
\def\illinois@paperauthors{First Author}
\def\illinois@affiliations{}
\def\illinois@notes{}
\def\illinois@abstract{}
\def\illinois@date{}
\def\illinois@contact{}
\def\illinois@links{}
\def\illinois@label{}
\newcommand{\papertitle}[1]{\gdef\illinois@papertitle{#1}}
\newcommand{\paperauthors}[1]{\gdef\illinois@paperauthors{#1}}
\newcommand{\paperaffiliation}[2][]{%
  \g@addto@macro\illinois@affiliations{\mbox{\textsuperscript{#1}#2}\hspace{0.7em}}}
\newcommand{\papernote}[1]{\g@addto@macro\illinois@notes{#1\hspace{0.65em}}}
\newcommand{\paperabstract}[1]{\gdef\illinois@abstract{#1}}
\newcommand{\paperdate}[1]{\gdef\illinois@date{#1}}
\newcommand{\papercontact}[1]{\gdef\illinois@contact{#1}}
\newcommand{\paperlabel}[1]{\gdef\illinois@label{#1}}
\newcommand{\paperlink}[2]{%
  \g@addto@macro\illinois@links{\illinois@metarow{\faLink}{#1}{#2}}}
\newcommand{\illinois@metarow}[3]{%
  \noindent\makebox[1.25em][c]{\color{illinoisblue}#1}%
  \hspace{0.25em}{\sffamily\bfseries #2:}\enspace #3\par}
\newcommand{\illinois@metablock}{%
  \ifx\illinois@date\@empty\else\illinois@metarow{\faCalendar}{Date}{\illinois@date}\fi
  \ifx\illinois@contact\@empty\else\illinois@metarow{\faEnvelope}{Correspondence}{\illinois@contact}\fi
  \illinois@links}


\newcommand{\makeillinoistitle}{%
  \begin{tcolorbox}[enhanced,colback=illinoiscard,frame hidden,boxrule=0pt,arc=7pt,
    left=20pt,right=20pt,top=18pt,bottom=16pt,
    before skip=0pt,after skip=16pt]
    \raggedright
    \ifx\illinois@label\@empty\else
      {\sffamily\bfseries\scriptsize\color{illinoisblue}\MakeUppercase{\illinois@label}}\par\vspace{5pt}
    \fi
    {\sffamily\bfseries\fontsize{20.5}{25}\selectfont\color{illinoisblue}%
      \illinois@papertitle\par}
    \vspace{12pt}
    {\sffamily\fontsize{10.5}{14}\selectfont\color{illinoistext}%
      \illinois@paperauthors\par}
    \vspace{5pt}
    {\sffamily\footnotesize\color{illinoissoft}%
      \illinois@affiliations\par}
    \ifx\illinois@notes\@empty\else
      \vspace{2pt}{\sffamily\footnotesize\color{illinoissoft}\illinois@notes\par}
    \fi
    \vspace{12pt}
    {\fontsize{10}{13.2}\selectfont\justifying\illinois@abstract\par}
    \vspace{12pt}
    \noindent\begin{minipage}[b]{\dimexpr\linewidth-11.8em\relax}%
      \raggedright\fontsize{9}{12.5}\selectfont
      \setlength{\parskip}{1.5pt}\illinois@metablock
    \end{minipage}%
    \hfill
    \begin{minipage}[b]{11.3em}%
      \raggedleft\includegraphics[width=\linewidth]{assets/illinois-formal-wordmark.png}%
    \end{minipage}%
  \end{tcolorbox}%
}

% Captions and diagrams. \illustrativeteaser is deliberately not a float,
% so it stays DIRECTLY under the title card (single and two-column header).
\newcommand{\illustrativeteaser}{%
  \begin{center}
  \begin{tikzpicture}
  \begin{axis}[
    width=\linewidth,height=4.7cm,
    ybar,bar width=8.6pt,ymin=0,ymax=90,
    symbolic x coords={Group A,Group B,Group C,Group D,Group E},
    xtick=data,enlarge x limits=0.13,
    ylabel={Score},
    axis x line*=bottom,axis y line*=left,
    axis line style={illinoismuted},tick style={illinoismuted},
    tick label style={font=\sffamily\scriptsize,color=illinoissoft},
    label style={font=\sffamily\small},
    ymajorgrids,grid style={illinoisline},
    legend style={at={(0.5,1.04)},anchor=south,legend columns=3,
      font=\sffamily\scriptsize,draw=none,fill=none},
    nodes near coords,
    every node near coord/.append style={font=\tiny,color=illinoissoft},
    ]
    \addplot[fill=illinoisblue,draw=none] coordinates {
      (Group A,82) (Group B,68) (Group C,58) (Group D,54) (Group E,61)};
    \addplot[fill=illinoisorange,draw=none] coordinates {
      (Group A,78) (Group B,63) (Group C,55) (Group D,49) (Group E,52)};
    \addplot[fill=illinoismuted!55,draw=none] coordinates {
      (Group A,71) (Group B,57) (Group C,47) (Group D,45) (Group E,44)};
    \legend{Approach A,Approach B,Approach C}
  \end{axis}
  \end{tikzpicture}
  \captionof{figure}{A sample teaser figure using illustrative values only. Replace with your actual result.}
  \label{fig:teaser}
  \end{center}
}

\titleformat{\section}{\sffamily\bfseries\fontsize{13}{16}\selectfont\color{illinoistext}}{\thesection}{0.7em}{}
\titleformat{\subsection}{\sffamily\bfseries\fontsize{11}{14}\selectfont\color{illinoistext}}{\thesubsection}{0.65em}{}
\titleformat{\subsubsection}{\sffamily\bfseries\normalsize\color{illinoistext}}{\thesubsubsection}{0.6em}{}
\titlespacing*{\section}{0pt}{1.4em}{0.6em}
\titlespacing*{\subsection}{0pt}{1.1em}{0.45em}
\titlespacing*{\subsubsection}{0pt}{0.9em}{0.35em}
\newtcolorbox{takeaway}[1][Key Takeaways]{enhanced,breakable,colback=illinoiscard,
  frame hidden,boxrule=0pt,arc=5pt,left=12pt,right=12pt,
  top=8pt,bottom=8pt,before skip=10pt,after skip=10pt,
  fonttitle=\sffamily\bfseries\small,coltitle=illinoisblue,
  colbacktitle=illinoiscard,title={#1},attach title to upper={\par\vspace{3pt}}}
\newtcolorbox{finding}[1][Finding]{enhanced,breakable,colback=white,
  colframe=illinoisline,boxrule=0.6pt,arc=5pt,left=12pt,right=12pt,
  top=8pt,bottom=8pt,before skip=10pt,after skip=10pt,
  fonttitle=\sffamily\bfseries\small,coltitle=illinoisblue,
  colbacktitle=white,title={#1},attach title to upper={\enspace}}
\newtcolorbox{promptbox}[1][Prompt]{enhanced,breakable,colback=illinoiscard,
  frame hidden,boxrule=0pt,arc=5pt,left=12pt,right=12pt,top=8pt,bottom=8pt,
  before skip=10pt,after skip=10pt,fontupper=\ttfamily\small,
  fonttitle=\sffamily\bfseries\small,coltitle=illinoissoft,
  colbacktitle=illinoiscard,title={#1},attach title to upper={\par\vspace{3pt}}}
\newtheorem{theorem}{Theorem}
\newtheorem{lemma}{Lemma}
\theoremstyle{definition}\newtheorem{definition}{Definition}
\newcommand{\best}[1]{\textbf{#1}}
\newcommand{\second}[1]{\underline{#1}}
\newcommand{\oursrow}{\rowcolor{illinoislight}}
