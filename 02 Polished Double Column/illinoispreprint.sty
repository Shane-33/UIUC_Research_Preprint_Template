\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{illinoispreprint}[2026/11/17 v2.0 Illinois research preprint]

% Page proportions match the single-column reference: US Letter, 1-inch margins.
\RequirePackage[letterpaper,margin=1in,footskip=28pt]{geometry}
\RequirePackage{iftex}
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \RequirePackage[utf8]{inputenc}
\fi
\RequirePackage{amsmath,amssymb,amsthm}
\RequirePackage{newtxtext,newtxmath} % readable Times-style academic text
\RequirePackage[scale=0.92]{inter} % sans headings and title (as in the reference)
\RequirePackage{microtype}
\RequirePackage[dvipsnames,table]{xcolor}
\definecolor{illinoisblue}{HTML}{13294B}
\definecolor{illinoisorange}{HTML}{FF5F05}
\definecolor{illinoistext}{HTML}{192235}
\definecolor{illinoissoft}{HTML}{4F5A6E}
\definecolor{illinoismuted}{HTML}{8490A3}
\definecolor{illinoisline}{HTML}{DCE3EE}
\definecolor{illinoiscard}{HTML}{F1F5FB}
\definecolor{illinoislight}{HTML}{E8EFF8}
\RequirePackage{graphicx}
\RequirePackage{booktabs,multirow,array,tabularx}
\RequirePackage{caption,subcaption}
\RequirePackage[shortlabels]{enumitem}
\RequirePackage{titlesec,fancyhdr}
\RequirePackage{ragged2e}
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.17}
\RequirePackage[most]{tcolorbox}
\RequirePackage{fontawesome5}
